# 로컬 개발용 시크릿. 이 파일을 `.dev.vars` 로 복사해서 값을 채운다.
# `.dev.vars` 는 .gitignore 에 포함되어 커밋되지 않는다.
# 배포 환경에는 `wrangler secret put <NAME>` 으로 등록한다.

# 세션 토큰(JWT) 서명 키. 임의의 긴 랜덤 문자열.
#   openssl rand -base64 48
SESSION_SECRET="dev-only-change-me-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 부모가 설정 화면에서 입력한 OPENAI_API_KEY 를 D1 에 저장할 때 쓰는 AES-GCM 마스터 키(base64, 32바이트).
#   openssl rand -base64 32
ENCRYPTION_KEY="dev-only-change-me-xxxxxxxxxxxxxxxxxxxxxxxxx="

# 회원가입 초대 코드. **반드시 설정해야 한다.**
# 비워 두면 가입이 막힌다 — 열린 채로 두는 것보다 안전한 쪽으로 닫는다.
#
# 이 저장소는 공개다. 실제 코드는 여기 적지 말고 `.dev.vars`(로컬)와
# `wrangler secret put INVITE_CODE`(배포)에만 둔다.
INVITE_CODE="change-me"

# ── 서비스 공용 외부 API 키 (부모별이 아니다) ─────────────────────
# 셋 다 선택이다. 없으면 그 소스만 조용히 건너뛰고 나머지는 그대로 동작한다.

# 알라딘 서지 조회. https://www.aladin.co.kr/ttb/wblock.aspx?pn=apiguide
ALADIN_TTB_KEY=""

# 카카오 책 검색. https://developers.kakao.com/ → 내 애플리케이션 → REST API 키
KAKAO_REST_KEY=""

# Tavily 웹 검색. https://app.tavily.com (가입 즉시 발급, 신용카드 불필요)
#
# 무료 등급은 **계정당** 월 1,000 크레딧이다. 계정을 여럿 만들어 번호 순서대로 넣으면
# 앞 키가 바닥날 때(432 Plan Limit Exceeded) 다음 키로 자동으로 넘어간다.
# 키 하나만 넣어도 되고, 아예 없으면 웹 검색만 조용히 건너뛴다.
#
# 서버가 키마다 상한 950 으로 스스로 막는다(src/services/search-budget.ts).
#
# 지금 쓰는 계정 — 잔량을 보려면 그 계정으로 app.tavily.com 에 로그인한다.
#   TAVILY_API_KEY  : keymann82@gmail.com
#   TAVILY_API_KEY2 : keymann.psn@gmail.com
#   TAVILY_API_KEY3 : keymann.usa@gmail.com
#   TAVILY_API_KEY4 : jyj02190174@gmail.com
#
# 자세한 내용은 docs/tavily-search-plan.md.
TAVILY_API_KEY=""
TAVILY_API_KEY2=""
TAVILY_API_KEY3=""
TAVILY_API_KEY4=""
